# This is a sample environment config.  Copy to .env.local and set the appropriate values.
#
# Setup for ThoughtSpot URLs.
#
NEXT_PUBLIC_THOUGHTSPOT_HOST=https://path.to.thoughtspot
TS_MCP_URL=https://agent.thoughtspot.app/token/mcp
#
# Token service (ts-embed-lab-token-service) that issues ThoughtSpot tokens
# for embedding, REST APIs, and MCP.  Server side only.
#
TOKEN_SERVICE_URL=https://ts-embed-lab-token-service.vercel.app
TOKEN_SERVICE_API_KEY=token-service-api-key
TS_INSTANCE=instance-name # name from the token service config, not a URL
TS_ORG= # optional when the instance has only one org
TS_USERNAME=ts-hol
#
# LiteLLM AI gateway (hol-ai-gateway) used by Banksy.  Server side only.
#
LITELLM_URL=https://hol-ai-gateway.vercel.app
LITELLM_API_KEY=sk-hol-xxx
LITELLM_MODEL=claude-sonnet
LITELLM_MAX_TOKENS=16000 # this may need to be bigger.
