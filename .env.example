# This is a sample environment config.  Copy to .env.local and set the appropriate values.
#
# Setup for ThoughtSpot URLs.
#
NEXT_PUBLIC_THOUGHTSPOT_HOST=https://path.to.thoughtspot
TS_USERNAME=ts-hol
#
# TODO create a separate server that gives keys for valid users. 
#
TS_SECRET_KEY=secret-key
TS_MCP_URL=https://agent.thoughtspot.app/token/mcp
#
# Using LiteLLM for the MCP capabilities.
#
LITELLM_URL=http://localhost:4000
LITELLM_API_KEY=sk-hol-xxx
LITELLM_MODEL=claude-sonnet
LITELLM_MAX_TOKENS=16000 # this may need to be bigger.
